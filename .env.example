# Copy to `.env` and fill in your own values: cp .env.example .env
# docker compose reads this automatically. `.env` is gitignored.

# The speaker's real IP on its own VLAN (required).
SPEAKER_HOST=192.0.2.20

# This host's own IP, on the SAME VLAN/subnet as the speaker (required). Must be a real
# routable address, not 127.0.0.1 -- clients on other VLANs need to reach it, and zeroconf
# needs to bind a real interface for multicast.
RELAY_HOST=192.0.2.10
